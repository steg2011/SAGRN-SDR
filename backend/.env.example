# SAGRN SDR Backend Configuration

# Database URL (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/sagrn.db

# Nominatim geocoding service
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=sagrn-sdr-monitor/1.0

# CFS incident feeds
CFS_INCIDENTS_XML=https://data.eso.sa.gov.au/prod/cfs/criimson/cfs_current_incidents.xml
CFS_CAP_XML=https://data.eso.sa.gov.au/prod/cfs/criimson/cfs_cap_incidents.xml

# Data retention (days)
MESSAGE_RETENTION_DAYS=30

# Geocoding rate limit (requests per second)
GEOCODE_RATE_LIMIT=1.0
