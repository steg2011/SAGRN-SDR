# SAGRN SDR Monitor - Docker Deployment Configuration

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://sagrn:changeme@db:5432/sagrn
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# CFS incident feeds
CFS_INCIDENTS_XML=https://data.eso.sa.gov.au/prod/cfs/criimson/cfs_current_incidents.xml
CFS_CAP_XML=https://data.eso.sa.gov.au/prod/cfs/criimson/cfs_cap_incidents.xml

# Data retention (hours)
MESSAGE_RETENTION_HOURS=24

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Collector
COLLECTOR_ID=pager1
PAGER_FREQUENCY=148.8125M
