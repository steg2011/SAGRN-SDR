# SAGRN SDR Backend Configuration (Lightweight GCP Edition)

# Database URL (SQLite for lightweight operation)
DATABASE_URL=sqlite+aiosqlite:///./data/sagrn.db

# CFS incident feeds (provides location data without external geocoding)
CFS_INCIDENTS_XML=https://data.eso.sa.gov.au/prod/cfs/criimson/cfs_current_incidents.xml
CFS_CAP_XML=https://data.eso.sa.gov.au/prod/cfs/criimson/cfs_cap_incidents.xml

# Data retention (hours) - 24 hours for lightweight operation
MESSAGE_RETENTION_HOURS=24

# Server configuration for GCP free tier
HOST=0.0.0.0
PORT=8000
WORKERS=1
